<style>
  /* === Header background CSS vars (adapt to dark mode) === */
  :root {
    --header-bg: rgba(250, 251, 252, 0.86);
    --mobile-menu-bg: rgba(250, 251, 252, 0.96);
  }
  [data-theme="dark"] {
    --header-bg: rgba(10, 14, 26, 0.86);
    --mobile-menu-bg: rgba(10, 14, 26, 0.96);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --header-bg: rgba(10, 14, 26, 0.86);
      --mobile-menu-bg: rgba(10, 14, 26, 0.96);
    }
  }

  /* === Logo dark mode invert === */
  [data-theme="dark"] .logo-img,
  :root:not([data-theme="light"]) .logo-img {
    filter: brightness(0) invert(1);
  }

  /* === Mega-menu keyboard a11y (focus-within support) === */
  .mega-menu-group:focus-within .mega-menu-panel {
    opacity: 1 !important;
    visibility: visible !important;
  }

  /* === Mega-menu panel bg (adapts via --card var) === */
  .mega-menu-panel {
    background: var(--card);
  }

  /* === Mobile menu panel bg === */
  .mobile-menu-panel {
    background: var(--mobile-menu-bg);
  }

  /* === Mega-menu featured card === */
  .mega-menu-featured {
    margin-top: 0.25rem;
    border-top: 1px solid var(--line);
    padding: 0.75rem 1rem;
    background: var(--accent-light);
    border-radius: 0 0 0.375rem 0.375rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .mega-menu-featured a {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .mega-menu-featured a:hover {
    color: var(--accent-strong);
  }
  .mega-menu-featured-thumb {
    width: 2rem;
    height: 2rem;
    border-radius: 0.25rem;
    background: var(--gradient-accent);
    flex-shrink: 0;
  }

  /* === Search button === */
  .search-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.25rem;
    width: 2.25rem;
    border: 1px solid var(--line);
    border-radius: 0.25rem;
    color: var(--muted);
    transition: color 0.2s ease;
  }
  .search-btn:hover {
    color: var(--accent);
  }

  /* === Mobile accordion === */
  .mobile-accordion details {
    border-bottom: 1px solid var(--line);
  }
  .mobile-accordion > details > summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    cursor: pointer;
    padding: 0.75rem 0;
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--ink);
    list-style: none;
  }
  .mobile-accordion > details > summary::-webkit-details-marker {
    display: none;
  }
  .mobile-accordion > details > summary::after {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-right: 2px solid var(--muted);
    border-bottom: 2px solid var(--muted);
    transform: rotate(45deg);
    transition: transform 0.2s ease;
    margin-left: auto;
  }
  .mobile-accordion > details[open] > summary::after {
    transform: rotate(225deg);
  }
  .mobile-accordion .accordion-content {
    animation: accordion-open 0.2s ease-out;
  }
  @keyframes accordion-open {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .mobile-accordion .sub-section-label {
    display: block;
    padding: 0.625rem 0 0.25rem;
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--slate);
  }
  .mobile-accordion .mobile-link {
    min-height: 44px;
    display: flex;
    align-items: center;
    padding: 0.5rem 0.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
    transition: color 0.15s ease;
  }
  .mobile-accordion .mobile-link:hover {
    color: var(--accent);
  }
  .mobile-accordion .mobile-link[aria-current="page"] {
    color: var(--accent);
    font-weight: 600;
  }
  .mobile-accordion .mobile-link-direct {
    min-height: 44px;
    display: flex;
    align-items: center;
    padding: 0.75rem 0;
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--ink);
    border-bottom: 1px solid var(--line);
  }
  .mobile-accordion .mobile-link-direct:hover {
    color: var(--accent);
  }
  .mobile-accordion .mobile-link-direct[aria-current="page"] {
    color: var(--accent);
  }
  .mobile-accordion .mobile-cta {
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.75rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink);
    border-radius: 0.25rem;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .mobile-accordion .mobile-cta:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* === Reduced motion === */
  @media (prefers-reduced-motion: reduce) {
    .mega-menu-panel,
    .mobile-accordion .accordion-content,
    .mobile-accordion > details > summary::after,
    .hamburger-bar,
    .search-btn,
    .mobile-link,
    .mobile-link-direct,
    .mobile-cta {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

