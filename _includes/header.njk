<script>
(function() {
  // Guard against double init (footer.njk may also run some of these)
  if (window.__headerInit) return;
  window.__headerInit = true;

  // --- Nav scroll state (moved from footer.njk) ---
  var header = document.getElementById('site-header');
  if (header) {
    var ticking = false;
    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(function() {
          if (window.scrollY > 50) {
            header.classList.add('nav-scrolled');
          } else {
            header.classList.remove('nav-scrolled');
          }
          ticking = false;
        });
        ticking = true;
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // --- Active page indicator (aria-current) ---
  var path = window.location.pathname;
  if (path.length > 1) path = path.replace(/\/$/, '');
  var navLinks = document.querySelectorAll('#site-header a[href]');
  navLinks.forEach(function(link) {
    var href = link.getAttribute('href');
    if (!href || href === '#' || href.indexOf('http') === 0 || href.charAt(0) !== '/') return;
    if (href === path) {
      link.setAttribute('aria-current', 'page');
    }
  });

  // --- Mega-menu keyboard a11y (aria-expanded on focus/blur) ---
  var megaTriggers = document.querySelectorAll('.mega-menu-trigger');
  megaTriggers.forEach(function(trigger) {
    var group = trigger.closest('.mega-menu-group');
    if (!group) return;
    trigger.addEventListener('focus', function() {
      trigger.setAttribute('aria-expanded', 'true');
    });
    group.addEventListener('focusout', function(e) {
      if (!group.contains(e.relatedTarget)) {
        trigger.setAttribute('aria-expanded', 'false');
      }
    });
    // Close on click outside
    document.addEventListener('click', function(e) {
      if (!group.contains(e.target)) {
        trigger.setAttribute('aria-expanded', 'false');
      }
    });
  });

  // --- Escape key to close mega-menus ---
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      var openTriggers = document.querySelectorAll('.mega-menu-trigger[aria-expanded="true"]');
      openTriggers.forEach(function(trigger) {
        trigger.setAttribute('aria-expanded', 'false');
        if (document.activeElement && document.activeElement.closest('.mega-menu-group')) {
          document.activeElement.blur();
        }
      });
    }
  });

  // --- Mobile menu: close on link click ---
  var mobileMenu = document.getElementById('mobile-menu');
  var mobileToggle = document.getElementById('mobile-menu-toggle');
  if (mobileMenu) {
    mobileMenu.querySelectorAll('a').forEach(function(link) {
      link.addEventListener('click', function() {
        mobileMenu.classList.add('hidden');
        if (mobileToggle) {
          mobileToggle.setAttribute('aria-expanded', 'false');
        }
      });
    });
  }
})();
</script>
