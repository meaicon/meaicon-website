<style>
  /* === Header background CSS vars (adapt to dark mode) === */
  :root {
    --header-bg: rgba(242, 241, 238, 0.86);
    --mobile-menu-bg: rgba(242, 241, 238, 0.96);
  }
  [data-theme="dark"] {
    --header-bg: rgba(43, 43, 43, 0.86);
    --mobile-menu-bg: rgba(43, 43, 43, 0.96);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --header-bg: rgba(43, 43, 43, 0.86);
      --mobile-menu-bg: rgba(43, 43, 43, 0.96);
    }
  }

  /* === Logo dark mode invert === */
  [data-theme="dark"] .logo-img,
  :root:not([data-theme="light"]) .logo-img {
    filter: brightness(0) invert(1);
  }

  /* === Mega-menu keyboard a11y (focus-within support) === */
  .mega-menu-group:focus-within .mega-menu-panel {
    opacity: 1 !important;
    visibility: visible !important;
  }

  /* === Mega-menu panel bg (adapts via --card var) === */
  .mega-menu-panel {
    background: var(--card);
  }

  /* === Mobile menu panel bg === */
  .mobile-menu-panel {
    background: var(--mobile-menu-bg);
  }

  /* === Mega-menu featured card === */
  .mega-menu-featured {
    margin-top: 0.25rem;
    border-top: 1px solid var(--line);
    padding: 0.75rem 1rem;
    background: var(--accent-light);
    border-radius: 0 0 0.375rem 0.375rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .mega-menu-featured a {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .mega-menu-featured a:hover {
    color: var(--accent-strong);
  }
  .mega-menu-featured-thumb {
    width: 2rem;
    height: 2rem;
    border-radius: 0.25rem;
    background: var(--gradient-accent);
    flex-shrink: 0;
  }

  /* === Search button === */
  .search-btn {
    padding: 0.5rem;
    color: var(--text-secondary);
    transition: color 0.2s;
  }
  .search-btn:hover {
    color: var(--accent);
  }
</style>

