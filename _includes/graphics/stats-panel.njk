<div class="stats-graphic" aria-label="MEAICON key metrics">
  <style>
    .stats-graphic {
      display: grid;
      gap: 1.5rem;
    }
    .stats-graphic * { box-sizing: border-box; }

    /* === Stat cards row === */
    .stats-cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
    .stat-card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 1.5rem 1.25rem;
      text-align: center;
      transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
      position: relative;
      overflow: hidden;
    }
    .stat-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: var(--accent);
      opacity: 0;
      transition: opacity 0.25s ease;
    }
    .stat-card:hover {
      border-color: var(--accent);
      box-shadow: 0 4px 20px rgba(10, 102, 194, 0.08);
      transform: translateY(-3px);
    }
    .stat-card:hover::before { opacity: 1; }

    .stat-icon {
      width: 32px;
      height: 32px;
      color: var(--accent);
      margin: 0 auto 0.75rem;
      display: block;
    }
    .stat-num {
      font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
      font-size: 2.25rem;
      font-weight: 800;
      color: var(--ink);
      line-height: 1;
      letter-spacing: -0.02em;
    }
    .stat-num .accent { color: var(--accent); }
    .stat-desc {
      font-size: 0.8125rem;
      color: var(--muted);
      margin-top: 0.4rem;
      font-weight: 500;
    }

    /* === Bar chart === */
    .stats-chart {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 1.75rem;
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 2rem;
      align-items: end;
    }
    .stats-chart-left h4 {
      font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
      font-size: 1rem;
      font-weight: 700;
      color: var(--ink);
      margin-bottom: 0.5rem;
    }
    .stats-chart-left p {
      font-size: 0.8125rem;
      color: var(--muted);
      line-height: 1.5;
    }
    .stats-bars {
      display: flex;
      align-items: flex-end;
      gap: 0.75rem;
      height: 120px;
    }
    .stats-bar-group {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
      height: 100%;
      justify-content: flex-end;
    }
    .stats-bar-track {
      width: 100%;
      max-width: 48px;
      height: 100%;
      background: var(--line);
      border-radius: 6px 6px 0 0;
      position: relative;
      overflow: hidden;
    }
    .stats-bar-fill {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      background: linear-gradient(180deg, var(--accent) 0%, var(--accent-strong) 100%);
      border-radius: 6px 6px 0 0;
      transition: height 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .stats-bar-label {
      font-size: 0.6875rem;
      color: var(--muted);
      font-weight: 500;
      white-space: nowrap;
    }
    .stats-bar-value {
      font-size: 0.6875rem;
      color: var(--ink);
      font-weight: 700;
    }

    /* === Coverage strip === */
    .stats-coverage {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 1.25rem 1.75rem;
      display: flex;
      align-items: center;
      gap: 1.5rem;
      flex-wrap: wrap;
    }
    .stats-coverage-label {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      white-space: nowrap;
    }
    .stats-coverage-dots {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .coverage-dot {
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }
    .coverage-dot::before {
      content: '';
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent);
    }
    .coverage-dot span {
      font-size: 0.8125rem;
      color: var(--ink);
      font-weight: 500;
    }

    @media (max-width: 768px) {
      .stats-cards { grid-template-columns: repeat(2, 1fr); }
      .stats-chart { grid-template-columns: 1fr; gap: 1.5rem; }
      .stats-coverage { flex-direction: column; align-items: flex-start; }
    }
    @media (max-width: 480px) {
      .stats-cards { grid-template-columns: 1fr; }
      .stats-bars { gap: 0.4rem; }
    }
  </style>

  <!-- Stat cards -->
  <div class="stats-cards">
    <div class="stat-card">
      <svg class="stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
      <div class="stat-num">1,400<span class="accent">+</span></div>
      <div class="stat-desc">Projects delivered</div>
    </div>
    <div class="stat-card">
      <svg class="stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
      <div class="stat-num">24/7</div>
      <div class="stat-desc">SOC &amp; NOC operations</div>
    </div>
    <div class="stat-card">
      <svg class="stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15 15 0 0 1 0 20a15 15 0 0 1 0-20"/></svg>
      <div class="stat-num">7</div>
      <div class="stat-desc">MEA markets</div>
    </div>
    <div class="stat-card">
      <svg class="stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
      <div class="stat-num">Full-stack</div>
      <div class="stat-desc">Single accountability</div>
    </div>
  </div>

  <!-- Bar chart: project volume by sector -->
  <div class="stats-chart">
    <div class="stats-chart-left">
      <h4>Delivery volume by sector</h4>
      <p>Project distribution across the industries we serve — government and financial services lead demand.</p>
    </div>
    <div class="stats-bars">
      <div class="stats-bar-group">
        <span class="stats-bar-value">38%</span>
        <div class="stats-bar-track"><div class="stats-bar-fill" style="height:95%"></div></div>
        <span class="stats-bar-label">Govt</span>
      </div>
      <div class="stats-bar-group">
        <span class="stats-bar-value">26%</span>
        <div class="stats-bar-track"><div class="stats-bar-fill" style="height:65%"></div></div>
        <span class="stats-bar-label">Banking</span>
      </div>
      <div class="stats-bar-group">
        <span class="stats-bar-value">14%</span>
        <div class="stats-bar-track"><div class="stats-bar-fill" style="height:35%"></div></div>
        <span class="stats-bar-label">Telecom</span>
      </div>
      <div class="stats-bar-group">
        <span class="stats-bar-value">12%</span>
        <div class="stats-bar-track"><div class="stats-bar-fill" style="height:30%"></div></div>
        <span class="stats-bar-label">Energy</span>
      </div>
      <div class="stats-bar-group">
        <span class="stats-bar-value">10%</span>
        <div class="stats-bar-track"><div class="stats-bar-fill" style="height:25%"></div></div>
        <span class="stats-bar-label">Other</span>
      </div>
    </div>
  </div>

  <!-- Coverage strip -->
  <div class="stats-coverage">
    <span class="stats-coverage-label">Active presence</span>
    <div class="stats-coverage-dots">
      <div class="coverage-dot"><span>UAE</span></div>
      <div class="coverage-dot"><span>Saudi Arabia</span></div>
      <div class="coverage-dot"><span>Qatar</span></div>
      <div class="coverage-dot"><span>Oman</span></div>
      <div class="coverage-dot"><span>Egypt</span></div>
      <div class="coverage-dot"><span>Kenya</span></div>
      <div class="coverage-dot"><span>India</span></div>
    </div>
  </div>
</div>
