  <!-- Legend -->
  <div class="map-legend" role="group" aria-label="Map legend">
    <span class="legend-item"><span class="legend-dot hq" aria-hidden="true"></span> HQ (UAE)</span>
    <span class="legend-item"><span class="legend-dot active" aria-hidden="true"></span> Active markets (7)</span>
    <span class="legend-item"><span class="legend-dot context" aria-hidden="true"></span> Regional context</span>
  </div>

  <div class="map-tooltip" id="map-tooltip"></div>

  <script>
  (function() {
    var wrapper = document.currentScript.closest('.world-map-wrapper');
    if (!wrapper) return;
    var tooltip = wrapper.querySelector('.map-tooltip');
    var items = wrapper.querySelectorAll('[data-country]');

    function showTip(e) {
      var el = e.currentTarget;
      var name = el.dataset.country;
      var detail = el.dataset.detail || '';
      var isHQ = el.dataset.hq === 'true';
      tooltip.textContent = (isHQ ? '\uD83C\uDFD2\uFE0F ' : '') + name + (detail ? ' \u2014 ' + detail : '');
      tooltip.classList.add('visible');
    }
    function moveTip(e) {
      var rect = wrapper.getBoundingClientRect();
      var x = e.clientX - rect.left + 12;
      var y = e.clientY - rect.top - 32;
      tooltip.style.left = x + 'px';
      tooltip.style.top = y + 'px';
    }
    function hideTip() {
      tooltip.classList.remove('visible');
    }

    items.forEach(function(el) {
      el.setAttribute('tabindex', '0');
      el.setAttribute('role', 'button');
      el.setAttribute('aria-label', el.dataset.country + (el.dataset.hq === 'true' ? ', HQ' : '') + ': ' + (el.dataset.detail || ''));
      el.addEventListener('mouseenter', showTip);
      el.addEventListener('mousemove', moveTip);
      el.addEventListener('mouseleave', hideTip);
      el.addEventListener('focus', showTip);
      el.addEventListener('blur', hideTip);
    });
  })();
  </script>
</div>
