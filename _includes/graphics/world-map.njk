<div class="world-map-wrapper" aria-label="MEAICON global presence map">
  <style>
    .world-map-wrapper {
      position: relative;
      width: 100%;
      max-width: 900px;
      margin: 0 auto;
      border-radius: 12px;
      overflow: hidden;
      background: var(--paper);
    }
    .world-map-svg {
      width: 100%;
      height: auto;
      display: block;
    }
    .world-map-svg .land {
      fill: var(--muted);
      fill-opacity: 0.12;
      stroke: var(--line);
      stroke-width: 0.4;
      stroke-linejoin: round;
    }
    .world-map-svg .land-active {
      fill: var(--accent);
      fill-opacity: 0.75;
      stroke: var(--accent-strong);
      stroke-width: 0.6;
    }
    .world-map-svg .land-active.hq {
      fill: var(--accent-strong);
      fill-opacity: 0.9;
    }
    .world-map-svg .land:hover:not(.land-active) {
      fill-opacity: 0.25;
      cursor: pointer;
    }
    .marker {
      fill: var(--accent);
      stroke: #fff;
      stroke-width: 1.2;
      cursor: pointer;
    }
    .marker.hq {
      fill: var(--accent-strong);
      stroke-width: 1.5;
    }
    .marker-pulse {
      fill: none;
      stroke: var(--accent);
      stroke-width: 1;
      opacity: 0.4;
    }
    .marker-pulse.hq {
      stroke: var(--accent-strong);
    }
    .marker-label {
      font-family: 'Inter', system-ui, sans-serif;
      font-size: 9px;
      font-weight: 600;
      fill: var(--ink);
      text-anchor: middle;
      pointer-events: none;
    }
    .marker-label.hq {
      font-weight: 700;
      fill: var(--accent-strong);
    }
    .map-tooltip {
      position: absolute;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 0.5rem 0.875rem;
      font-size: 0.8125rem;
      color: var(--ink);
      white-space: nowrap;
      box-shadow: 0 4px 20px rgba(0,0,0,0.12);
      opacity: 0;
      transition: opacity 0.18s;
      pointer-events: none;
      z-index: 10;
    }
    .map-tooltip.visible { opacity: 1; }
    .map-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      justify-content: center;
      margin-top: 0.75rem;
      padding: 0 1rem 0.5rem;
    }
    .legend-item {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      font-size: 0.75rem;
      color: var(--muted);
    }
    .legend-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .legend-dot.hq { background: var(--accent-strong); }
    .legend-dot.active { background: var(--accent); }
    .legend-dot.context { background: var(--muted); opacity: 0.3; }
    @keyframes pulse-ring {
      0% { r: 4; opacity: 0.6; }
      100% { r: 14; opacity: 0; }
    }
    .marker-pulse {
      animation: pulse-ring 2.5s ease-out infinite;
    }
    @media (prefers-reduced-motion: reduce) {
      .marker-pulse { animation: none; opacity: 0; }
    }
    @media (max-width: 640px) {
      .marker-label { font-size: 7px; }
    }
  </style>

  <svg class="world-map-svg" viewBox="0 0 1000 500" preserveAspectRatio="xMidYMid meet" role="img" aria-label="World map highlighting MEAICON presence in 7 MEA markets">
    <defs>
