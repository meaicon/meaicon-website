}
[data-theme="dark"] .content-section { background: var(--dark); }
[data-theme="dark"] .content-section-alt { background: rgba(255,255,255,0.02); }
[data-theme="dark"] .page-hero { background: var(--dark); border-color: rgba(255,255,255,0.08); }
[data-theme="dark"] .cta-section { background: linear-gradient(135deg, #0A0F1D 0%, #1E293B 100%); }
