/* ============================================
   Missing Layout & Component Classes
   ============================================ */

/* --- Grid Layouts --- */
.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2rem;
  align-items: stretch;
  grid-auto-rows: 1fr;
}
.grid-2 > * {
  height: 100%;
  display: flex;
  flex-direction: column;
}
@media (max-width: 768px) {
  .grid-2 { grid-template-columns: 1fr; }
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  align-items: stretch;
  grid-auto-rows: 1fr;
}
.grid-3 > * {
  height: 100%;
  display: flex;
  flex-direction: column;
}
}
@media (max-width: 768px) {
  .grid-3 { grid-template-columns: 1fr; }
}

.grid-auto {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1.5rem;
}
@media (max-width: 768px) {
  .grid-auto { grid-template-columns: 1fr; }
}

.grid-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}
@media (max-width: 768px) {
  .grid-cards { grid-template-columns: 1fr; }
}

/* --- Industry Cards --- */
.industry-card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 1.5rem;
  transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
  cursor: pointer;
  text-align: center;
}
.industry-card:hover {
  transform: translateY(-4px);
  border-color: var(--accent);
  box-shadow: var(--shadow-lg);
}
.industry-card h3 {
  font-size: 1rem;
  font-weight: 700;
  margin-bottom: 0.25rem;
  color: var(--ink);
}
.industry-card p {
  font-size: 0.8125rem;
  color: var(--muted);
}

/* --- Section Spacing --- */
.section-light {
  padding: 4rem 0;
  background: var(--paper);
}

.section-warm {
  padding: 4rem 0;
  background: var(--gradient-warm);
}

.section-top {
  padding: 3rem 0 2rem;
  background: var(--paper);
  border-bottom: 1px solid var(--line);
}

.section-pad {
  padding: 4rem 0;
}

/* --- Prose / Content Width --- */
.prose-width {
  max-width: 65ch;
  line-height: 1.7;
  color: var(--text-secondary);
}
.prose-width p {
  margin-bottom: 1.25rem;
}
.prose-width ul,
.prose-width ol {
  margin: 1rem 0 1rem 1.5rem;
}
.prose-width li {
  margin-bottom: 0.5rem;
}

/* --- Page Container --- */
.page-container {
  max-width: 1200px;
  margin: 0 auto;
}

/* --- Homepage Specific --- */
.hero-flex {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 1.5rem;
}
@media (max-width: 768px) {
  .hero-flex { flex-direction: column; }
}

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.75rem;
  color: var(--accent);
}
.status-badge span {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent);
  animation: pulse 2s infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* --- Contact Page --- */
.contact-info {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1.5rem;
}
.contact-item {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
}
.contact-icon {
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-light);
  border-radius: 10px;
  color: var(--accent);
}
.form-textarea {
  width: 100%;
  padding: 0.75rem 1rem;
  border: 1px solid var(--line);
  border-radius: 8px;
  font-size: 0.9375rem;
  font-family: inherit;
  background: #fff;
  color: var(--ink);
  resize: vertical;
  min-height: 120px;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.form-textarea:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(10, 102, 194, 0.12);
}

/* --- Feature Icon --- */
.feature-icon {
  width: 48px;
  height: 48px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-light);
  border-radius: 12px;
  color: var(--accent);
  margin-bottom: 1rem;
}
.feature-icon svg {
  width: 24px;
  height: 24px;
}

/* --- Statistics --- */
.stat-box {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 1.5rem;
  text-align: center;
}
.stat-label {
  font-size: 0.8125rem;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 0.5rem;
}
.stat-value {
  font-size: 2rem;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.2;
}
.stat-row {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5rem;
  align-items: center;
}
@media (max-width: 768px) {
  .stat-row { flex-direction: column; }
}

/* --- Step Number --- */
.step-number {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  font-size: 1rem;
  font-weight: 700;
  flex-shrink: 0;
}

/* --- Tags / Badges --- */
.tag {
  display: inline-block;
  padding: 0.25rem 0.625rem;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--muted);
  background: var(--accent-light);
  border-radius: 6px;
  text-decoration: none;
}
.tag-accent {
  display: inline-block;
  padding: 0.25rem 0.625rem;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--accent);
  background: var(--accent-light);
  border-radius: 6px;
  text-decoration: none;
}

/* --- CTA Band --- */
.cta-section {
  padding: 3rem 0;
  background: var(--accent-light);
  border-radius: 12px;
  text-align: center;
}
.cta-title {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--accent-strong);
  margin-bottom: 0.75rem;
}

/* --- Related Links --- */
.related-links {
  margin-top: 2rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--line);
}
.related-links ul {
  list-style: none;
  padding: 0;
}
.related-links li {
  margin-bottom: 0.5rem;
}
.related-links a {
  color: var(--accent);
  text-decoration: none;
  font-size: 0.9375rem;
}
.related-links a:hover {
  text-decoration: underline;
}

/* --- Insight Cards --- */
.insight-card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 1.5rem;
  transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
}
.insight-card:hover {
  transform: translateY(-4px);
  border-color: var(--accent);
  box-shadow: var(--shadow-lg);
}
.insight-meta {
  font-size: 0.8125rem;
  color: var(--muted);
  margin-bottom: 0.75rem;
}

/* --- Checklist --- */
.checklist {
  list-style: none;
  padding: 0;
}
.checklist li {
  position: relative;
  padding-left: 1.75rem;
  margin-bottom: 0.625rem;
  color: var(--text-secondary);
  line-height: 1.6;
}
.checklist li::before {
  content: "✓";
  position: absolute;
  left: 0;
  top: 0;
  color: var(--accent);
  font-weight: 700;
}

/* --- Footer Links --- */
.footer-links {
  list-style: none;
  padding: 0;
}
.footer-links li {
  margin-bottom: 0.5rem;
}
.footer-links a {
  color: var(--muted);
  text-decoration: none;
  font-size: 0.875rem;
  transition: color 0.2s;
}
.footer-links a:hover {
  color: var(--accent);
}

/* --- Hairline --- */
.hairline {
  border-color: var(--line);
}


/* ============================================
   MISSING LAYOUT & COMPONENT CLASSES
   ============================================ */

/* Grid Layouts */
.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2.5rem;
  align-items: stretch;
  grid-auto-rows: 1fr;
}
.grid-2 > * {
  height: 100%;
  display: flex;
  flex-direction: column;
}
.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  align-items: stretch;
  grid-auto-rows: 1fr;
}
.grid-3 > * {
  height: 100%;
  display: flex;
  flex-direction: column;
}
@media (max-width: 768px) {
  .grid-2,
  .grid-3 {
    grid-template-columns: 1fr;
  }
}

/* Page Sections */
.content-section {
  padding: 4rem 0;
  background: var(--paper);
}
.content-section-alt {
  padding: 4rem 0;
  background: var(--gradient-warm);
}
.page-hero {
  padding: 3rem 0 2rem;
  background: var(--paper);
  border-bottom: 1px solid var(--line);
}
.prose-content {
  max-width: 65ch;
  line-height: 1.7;
  color: var(--text-secondary);
}
.prose-content p { margin-bottom: 1.25rem; }
.prose-content ul, .prose-content ol { margin: 1rem 0 1rem 1.5rem; }
.prose-content li { margin-bottom: 0.5rem; }

/* Industry Grid & Cards (homepage) */
.industry-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1.5rem;
  align-items: stretch;
  grid-auto-rows: 1fr;
}
.industry-grid > * {
  height: 100%;
}
.industry-card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 1.75rem 1.5rem;
  text-align: center;
  transition: transform 0.25s cubic-bezier(0.4,0,0.2,1),
              box-shadow 0.25s cubic-bezier(0.4,0,0.2,1),
              border-color 0.25s ease;
  cursor: pointer;
}
.industry-card:hover {
  transform: translateY(-4px);
  border-color: var(--accent);
  box-shadow: var(--shadow-lg);
}
.industry-card h3 {
  font-size: 1rem;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 0.35rem;
}
.industry-card p {
  font-size: 0.8125rem;
  color: var(--muted);
  line-height: 1.5;
}

/* Hero Dashboard */
.dashboard-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 1.5rem;
}
.status-indicator {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.75rem;
  color: var(--accent);
  white-space: nowrap;
}
.status-indicator span {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent);
  animation: pulse 2s infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* Feature Grid & Icon */
.feature-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 2rem;
  margin-top: 2rem;
  align-items: stretch;
  grid-auto-rows: 1fr;
}
.feature-grid > .feature-card,
.feature-grid > .solution-card,
.feature-grid > .card,
.feature-grid > [class*="card"] {
  height: 100%;
  display: flex;
  flex-direction: column;
}
.feature-grid > .feature-card > *:last-child,
.feature-grid > .solution-card > *:last-child,
.feature-grid > .card > *:last-child {
  margin-top: auto;
}
.feature-icon {
  width: 40px;
  height: 40px;
  color: var(--accent);
  margin-bottom: 1rem;
  flex-shrink: 0;
}

/* Statistics */
.stat-box {
  text-align: center;
  padding: 1.5rem;
  border-radius: 12px;
  background: var(--card);
  border: 1px solid var(--line);
}
.stat-value {
  font-family: 'Inter', sans-serif;
  font-size: 2.25rem;
  font-weight: 800;
  color: var(--accent);
  line-height: 1.1;
  letter-spacing: -0.02em;
}
.stat-label {
  font-size: 0.8125rem;
  color: var(--muted);
  margin-top: 0.5rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.stat-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 1.5rem;
  margin-top: 2rem;
}

/* Step Number */
.step-number {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 50%;
  background: var(--accent-light);
  color: var(--accent);
  font-family: 'Inter', sans-serif;
  font-weight: 700;
  font-size: 0.9375rem;
  flex-shrink: 0;
}

/* Tags */
.tag {
  display: inline-block;
  padding: 0.25rem 0.75rem;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 600;
  background: var(--card);
  border: 1px solid var(--line);
  color: var(--muted);
}
.tag-accent {
  background: var(--accent-light);
  border-color: var(--accent);
  color: var(--accent);
}

/* CTA Section */
.cta-section {
  background: var(--gradient-dark);
  color: #fff;
  padding: 4rem 2rem;
  text-align: center;
  border-radius: 16px;
  margin: 3rem 0;
}
.cta-title {
  font-family: 'Inter', sans-serif;
  font-size: 2rem;
  font-weight: 700;
  color: #fff;
  margin-bottom: 1rem;
}

/* Contact Page */
.contact-info {
  font-size: 0.9375rem;
  line-height: 1.8;
  color: var(--text-secondary);
}
.contact-item {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  margin-bottom: 1.25rem;
}
.contact-icon {
  width: 24px;
  height: 24px;
  color: var(--accent);
  flex-shrink: 0;
  margin-top: 0.15rem;
}

/* Form Textarea */
.form-textarea {
  width: 100%;
  padding: 0.75rem 1rem;
  border: 1px solid var(--line);
  border-radius: 8px;
  font-family: inherit;
  font-size: 0.9375rem;
  line-height: 1.6;
  resize: vertical;
  min-height: 120px;
  background: var(--paper);
  color: var(--ink);
  transition: border-color 0.2s ease;
}
.form-textarea:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-light);
}

/* Related Links */
.related-links {
  margin-top: 3rem;
  padding-top: 2rem;
  border-top: 1px solid var(--line);
}
.related-links h3 {
  font-family: 'Inter', sans-serif;
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 1rem;
}
.related-links ul {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 0.75rem;
  list-style: none;
  padding: 0;
}
.related-links a {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1rem;
  border: 1px solid var(--line);
  border-radius: 8px;
  text-decoration: none;
  color: var(--text-secondary);
  font-size: 0.875rem;
  transition: border-color 0.2s, color 0.2s;
}
.related-links a:hover {
  border-color: var(--accent);
  color: var(--accent);
}

/* Insight Cards */
.insight-card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 1.75rem;
  transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
  display: flex;
  flex-direction: column;
  height: 100%;
}
.insight-card:hover {
  transform: translateY(-3px);
  border-color: var(--accent);
  box-shadow: var(--shadow-lg);
}
.insight-meta {
  font-size: 0.75rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 0.75rem;
}

/* Checklist */
.checklist {
  list-style: none;
  padding: 0;
  margin: 1.5rem 0;
}
.checklist li {
  position: relative;
  padding-left: 1.75rem;
  margin-bottom: 0.75rem;
  line-height: 1.6;
  color: var(--text-secondary);
}
.checklist li::before {
  content: '\2713';
  position: absolute;
  left: 0;
  top: 0;
  color: var(--accent);
  font-weight: 700;
}

/* Hairline */
.hairline { border-color: var(--line); }

/* Footer Links */
.footer-links {
  list-style: none;
  padding: 0;
  margin: 0;
}
.footer-links li { margin-bottom: 0.5rem; }
.footer-links a {
  font-size: 0.875rem;
  color: var(--text-secondary);
  text-decoration: none;
  transition: color 0.2s ease;
}
.footer-links a:hover { color: var(--accent); }

/* Site Shell */
.site-shell { width: 100%; }

/* Utilities */
.list-disc { list-style-type: disc; padding-left: 1.5rem; }
.inline-block { display: inline-block; }
.cursor-pointer { cursor: pointer; }
.accent-accent { color: var(--accent); }

/* Dark mode overrides */
[data-theme="dark"] .industry-card,
[data-theme="dark"] .insight-card,
[data-theme="dark"] .stat-box {
  background: rgba(255,255,255,0.03);
  border-color: rgba(255,255,255,0.08);
}
[data-theme="dark"] .industry-card:hover,
[data-theme="dark"] .insight-card:hover {
