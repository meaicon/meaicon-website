/* ============================================
   Head CSS Variables & Base Styles
   ============================================ */

/* --- Color Tokens (Kyndryl-Inspired Enterprise Minimalist Theme) --- */
:root {
  --accent: #0A66C2; /* Professional Enterprise Blue */
  --accent-strong: #004182;
  --accent-light: #EBF3F9;
  --warning: #F59E0B;
  --danger: #DC2626;

  /* Backgrounds */
  --paper: #FFFFFF;
  --card: #F8FAFC;
  --ink: #0F172A;
  --muted: #475569;
  --line: #E2E8F0;
  --dark: #0A0F1D;

  /* Text */
  --text-primary: #0F172A;
  --text-secondary: #475569;
  --text-muted: #94A3B8;
  --text-on-dark: #F8FAFC;

  /* Shadows */
  --shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);

  /* Gradients */
  --gradient-accent: linear-gradient(135deg, #0A66C2 0%, #004182 100%);
  --gradient-hero: linear-gradient(135deg, #0A0F1D 0%, #1E293B 100%);
  --gradient-dark: linear-gradient(135deg, #0A0F1D 0%, #0F172A 100%);
  --gradient-band: linear-gradient(90deg, transparent 0%, #0A66C2 50%, transparent 100%);
  --gradient-warm: linear-gradient(135deg, #F8FAFC 0%, #F1F5F9 100%);
  --gradient-btn-hover: linear-gradient(135deg, #004182 0%, #0A66C2 100%);
}

/* Skip Link — visually hidden until focus */
.skip-link {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
}
.skip-link:focus {
  position: fixed;
  top: 1rem;
  left: 1rem;
  width: auto;
  height: auto;
  clip: auto;
  padding: 0.75rem 1.25rem;
  background: var(--accent);
  color: #FFFFFF;
  border-radius: 6px;
  z-index: 9999;
  font-weight: 500;
  font-size: 0.875rem;
}

/* Reset & Base */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: var(--paper);
  color: var(--ink);
  font-family: 'Inter', 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 1rem;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Typography Base */
h1, h2, h3, h4, h5, h6 {
  font-family: 'Inter', 'Plus Jakarta Sans', sans-serif;
  font-weight: 400;
  line-height: 1.5;
  letter-spacing: -0.02em;
}

h1 { font-size: 40px; font-weight: 300; }
h2 { font-size: 45.6px; font-weight: 300; }

.display-title {
  font-weight: 300;
  font-size: clamp(2.5rem, 5vw, 3rem);
}

a {
  color: var(--accent);
  text-decoration: none;
  transition: color 0.2s ease;
}

a:hover {
  color: var(--accent-strong);
}

.btn {
  padding: 0.75rem 1.5rem;
  border-radius: 0.375rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}

.btn-primary {
  background: var(--gradient-accent);
  color: #FFFFFF;
}

.btn-primary:hover {
  background: var(--gradient-btn-hover);
}
