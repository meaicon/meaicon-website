/* ============================================
   Head CSS Variables & Base Styles
   ============================================ */

/* --- Color Tokens (Design Guidelines) --- */
/* Primary Accent — Brand Blue (#0066FF) */
:root {
  --accent: #0066FF;
  --accent-strong: #0044CC;
  --warning: #fbbf24;
  --danger: #ef4444;

  /* Backgrounds */
  --paper: #FAFBFC;
  --card: #FFFFFF;
  --ink: #0A192F;
  --muted: #475569;
  --line: #E2E8F0;
  --dark: #0a0e1a;

  /* Text */
  --text-primary: #0A192F;
  --text-secondary: #475569;
  --text-muted: #94A3B8;
  --text-on-dark: #F0F0F5;

  /* Shadows */
  --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 10px 24px -14px rgba(0, 0, 0, 0.4);
  --shadow-xl: 0 20px 40px -16px rgba(0, 0, 0, 0.5);

  /* Gradients */
  --gradient-accent: linear-gradient(135deg, #0066FF 0%, #0044CC 100%);
  --gradient-hero: linear-gradient(135deg, #F8FAFC 0%, #FFFFFF 72%);
  --gradient-dark: linear-gradient(135deg, #0a0e1a 0%, #1a2744 100%);
  --gradient-band: linear-gradient(90deg, transparent 0%, #0066FF 50%, transparent 100%);
  --gradient-warm: linear-gradient(135deg, #FAF9F7 0%, #F5F3EF 100%);
  --gradient-btn-hover: linear-gradient(135deg, #0044CC 0%, #0066FF 100%);
}

/* Reset & Base */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: var(--paper);
  color: var(--ink);
  font-family: 'Inter', 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 1rem;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Typography Base */
h1, h2, h3, h4, h5, h6 {
  font-family: 'Inter', 'Plus Jakarta Sans', sans-serif;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -0.02em;
}

p {
  line-height: 1.7;
  margin-bottom: 1rem;
}

/* Utility Classes */
.hidden {
  opacity: 0;
  pointer-events: none;
}

/* Navigation */
.nav-link {
  position: relative;
  color: rgba(10, 25, 47, 0.78);
}
.nav-link::after {
  content: '';
  position: absolute;
  left: 0; right: 0; bottom: -8px;
  height: 1px;
  background: var(--accent);
  transform: scaleX(0);
  transform-origin: left center;
  transition: transform 0.2s ease;
}
.nav-link:hover::after {
  transform: scaleX(1);
}
.nav-link:hover {
  color: var(--accent);
}

/* Buttons */
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: none;
  background: var(--gradient-accent);
  color: #fff;
  box-shadow: 0 2px 8px -2px rgba(0, 102, 255, 0.3);
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.875rem;
  padding: 0.75rem 1.5rem;
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  text-decoration: none;
  white-space: nowrap;
}
.btn-primary:hover {
  background: var(--gradient-btn-hover);
  box-shadow: 0 8px 24px -8px rgba(0, 102, 255, 0.45);
  transform: translateY(-2px);
}
.btn-primary:active {
  transform: translateY(0);
  box-shadow: 0 2px 6px -2px rgba(0, 102, 255, 0.3);
}
.btn-primary:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
}

/* Cards */
.card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 1.5rem;
  color: var(--ink);
  box-shadow: var(--shadow);
  transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
              box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1),
              border-color 0.25s ease;
}
.card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-xl);
  border-color: var(--accent);
}

/* Metric Cards */
.case-study-card {
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 2rem;
  box-shadow: var(--shadow);
  transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
              box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1),
              border-color 0.25s ease;
}
.case-study-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-xl);
  border-color: var(--accent);
}

/* CTAs */
.cta-section {
  background: var(--gradient-dark);
  position: relative;
  overflow: hidden;
}
.cta-section .cta-title {
  color: #fff;
  font-family: 'Inter', sans-serif;
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -0.02em;
}

/* Scrollbar */
::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}
::-webkit-scrollbar-track {
  background: var(--paper);
}
::-webkit-scrollbar-thumb {
  background: rgba(10, 25, 47, 0.2);
  border-radius: 5px;
  border: 2px solid var(--paper);
}
::-webkit-scrollbar-thumb:hover {
  background: rgba(10, 25, 47, 0.35);
}

/* Focus States */
*:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
  border-radius: 2px;
}

/* Responsive */
@media (prefers-reduced-motion: reduce) {
  .skeleton {
    animation: none;
  }
  .card:hover,
  .case-study-card:hover,
  .btn-primary:hover {
    transform: none;
  }
}

/* Skeleton Loader */
.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
  border-radius: 4px;
}
@keyframes skeleton-loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* Progress Bars */
.progress-track {
  background: rgba(10, 25, 47, 0.08);
  border-radius: 9999px;
  height: 6px;
  overflow: hidden;
}
.progress-fill {
  background: var(--gradient-accent);
  border-radius: 9999px;
  height: 100%;
  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Footer */
.footer {
  background: var(--paper);
}
