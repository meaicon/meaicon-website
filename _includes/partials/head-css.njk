/* ============================================
   Head CSS Variables & Base Styles
   ============================================ */

/* --- Color Tokens (Design Guidelines) --- */
:root {
  --accent: #29707A;
  --accent-strong: #1F5A61;
  --accent-light: #E4F4F1;
  --warning: #fbbf24;
  --danger: #ef4444;

  /* Backgrounds */
  --paper: #F2F1EE;
  --card: #FFFFFF;
  --ink: #3D3C3C;
  --muted: #565049;
  --line: #BBBBBB;
  --dark: #2B2B2B;

  /* Text */
  --text-primary: #3D3C3C;
  --text-secondary: #565049;
  --text-muted: #9E9287;
  --text-on-dark: #F0F0F5;

  /* Shadows */
  --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 10px 24px -14px rgba(0, 0, 0, 0.4);
  --shadow-xl: 0 20px 40px -16px rgba(0, 0, 0, 0.5);

  /* Gradients */
  --gradient-accent: linear-gradient(135deg, #29707A 0%, #1F5A61 100%);
  --gradient-hero: linear-gradient(135deg, #F2F1EE 0%, #E4F4F1 100%);
  --gradient-dark: linear-gradient(135deg, #2B2B2B 0%, #1a1a1a 100%);
  --gradient-band: linear-gradient(90deg, transparent 0%, #29707A 50%, transparent 100%);
  --gradient-warm: linear-gradient(135deg, #FAF9F7 0%, #F5F3EF 100%);
  --gradient-btn-hover: linear-gradient(135deg, #1F5A61 0%, #29707A 100%);
}

/* Skip Link — visually hidden until focus */
.skip-link {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
}
.skip-link:focus {
  position: fixed;
  top: 1rem;
  left: 1rem;
  width: auto;
  height: auto;
  clip: auto;
  padding: 0.75rem 1.25rem;
  background: var(--accent);
  color: #FFFFFF;
  border-radius: 6px;
  z-index: 9999;
  font-weight: 500;
  font-size: 0.875rem;
}

/* Reset & Base */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: var(--paper);
  color: var(--ink);
  font-family: 'Inter', 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 1rem;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Typography Base */
h1, h2, h3, h4, h5, h6 {
  font-family: 'Inter', 'Plus Jakarta Sans', sans-serif;
  font-weight: 400;
  line-height: 1.5;
  letter-spacing: -0.02em;
}

h1 { font-size: 40px; font-weight: 300; }
h2 { font-size: 45.6px; font-weight: 300; }

.display-title {
  font-weight: 300;
  font-size: clamp(2.5rem, 5vw, 3rem);
}

a {
  color: var(--accent);
  text-decoration: none;
  transition: color 0.2s ease;
}

a:hover {
  color: var(--accent-strong);
}

.btn {
  padding: 0.75rem 1.5rem;
  border-radius: 0.375rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}

.btn-primary {
  background: var(--gradient-accent);
  color: #FFFFFF;
}

.btn-primary:hover {
  background: var(--gradient-btn-hover);
}
