<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="canonical" href="{{ canonical | default('https://www.meaicon.com/') }}">
  <link rel="stylesheet" href="/assets/css/cookie-consent.css">
  <script src="/assets/js/cookie-consent.js" defer></script>
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta property="og:title" content="{{ ogTitle | default(title) }}">
  <meta property="og:description" content="{{ ogDescription | default(description) }}">
  <meta property="og:type" content="website">
  <meta property="og:image" content="https://www.meaicon.com/assets/brand/meaicon/meaicon-LLC-FZ-logo-black.png">
  <meta property="og:url" content="{{ canonical | default('https://www.meaicon.com/') }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ twitterTitle | default(ogTitle | default(title)) }}">
  <meta name="twitter:description" content="{{ twitterDescription | default(ogDescription | default(description)) }}">
  <meta name="twitter:image" content="https://www.meaicon.com/assets/brand/meaicon/meaicon-LLC-FZ-logo-black.png">
  {% if legacySource %}
  {{ legacySource | legacyJsonLd | safe }}
  {% else %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "MEAICON LLC FZ",
    "url": "https://www.meaicon.com/",
    "address": { "@type": "PostalAddress", "addressCountry": "AE", "addressLocality": "Dubai", "streetAddress": "Meydan Free Zone" },
    "contactPoint": { "@type": "ContactPoint", "telephone": "+971 55 513 5784", "contactType": "sales" },
    "sameAs": [
      "https://www.linkedin.com/company/meaicon/",
      "https://x.com/meaicon",
      "https://www.instagram.com/meaicon.official/",
      "https://www.facebook.com/Meaicon.Official",
      "https://www.youtube.com/channel/UCVbuZOFqHeFGAMmzu3jE3oA"
    ]
  }
  </script>
  {% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <!-- TODO: Migrate to build-time Tailwind for production — remove CDN script and 'unsafe-inline' CSP -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          paper: '#FAFBFC',
          card: '#FFFFFF',
          ink: '#0A192F',
          muted: '#475569',
          accent: '#0066FF',
          accentstrong: '#0044CC',
          teal: '#1E40AF',
          line: '#E2E8F0',
          dark: '#0A192F',
          slate: '#64748B'
        },
        fontFamily: {
          display:['"Plus Jakarta Sans"','sans-serif'],
          sans:['Inter','sans-serif'],
          mono:['"JetBrains Mono"','monospace']
        }
      }
    }
  }
  </script>
  <style>
    /* === Base === */
    :root {
      --paper: #FAFBFC;
      --card: #FFFFFF;
      --ink: #0A192F;
      --muted: #475569;
      --accent: #0066FF;
      --accent-strong: #0044CC;
      --accent-light: rgba(0, 102, 255, 0.08);
      --accent-glow: rgba(0, 102, 255, 0.35);
      --teal: #1E40AF;
      --line: #E2E8F0;
      --dark: #0a0e1a;
      --shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
      --shadow-lg: 0 10px 24px -14px rgba(15,23,42,0.25);
      --shadow-xl: 0 20px 40px -16px rgba(15,23,42,0.35);
      --slate: #64748B;
      /* Warm gray palette */
      --warm-50: #FAF9F7;
      --warm-100: #F5F3EF;
      --warm-200: #E8E4DD;
      --warm-300: #D6CFC2;
      --warm-400: #B8AFA0;
      --warm-500: #948A7A;
      --warm-600: #6B6357;
      --warm-700: #4A443C;
      --warm-800: #2E2A24;
      --warm-900: #1C1915;
      /* Gradient utilities */
      --gradient-accent: linear-gradient(135deg, #0066FF 0%, #0044CC 100%);
      --gradient-hero: linear-gradient(135deg, #F8FAFC 0%, #FFFFFF 72%);
      --gradient-dark: linear-gradient(135deg, #0a0e1a 0%, #1a2744 100%);
      --gradient-band: linear-gradient(90deg, transparent 0%, #0066FF 50%, transparent 100%);
      --gradient-warm: linear-gradient(135deg, #FAF9F7 0%, #F5F3EF 100%);
    }

    html, body { background: var(--paper); color: var(--ink); }
    body { background: var(--paper); font-family: 'Inter', sans-serif; }

    .font-display { font-family: 'Plus Jakarta Sans', sans-serif; }
    .font-mono { font-family: 'JetBrains Mono', monospace; }
    body, p, li, span, div { color: var(--muted); }
    h1, h2, h3, h4, h5, h6, strong, b { color: var(--ink); }

    ::selection { background: rgba(0, 102, 255, 0.15); color: var(--ink); }

    a { transition: color .15s ease, border-color .15s ease, background-color .15s ease, transform .15s ease, box-shadow .15s ease; }

    .nav-link {
      position: relative;
      color: rgba(10, 25, 47, 0.78);
    }
    .nav-link::after {
      content: '';
      position: absolute;
      left: 0; right: 0; bottom: -8px;
      height: 1px;
      background: var(--accent);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform .2s ease;
    }
    .nav-link:hover::after { transform: scaleX(1); }
    .nav-link:hover { color: var(--accent); }

    .hairline { border-color: rgba(148, 163, 184, 0.18); }

    .btn-primary {
      border: 1px solid var(--accent);
      background: var(--accent);
      color: #fff;
      box-shadow: var(--shadow);
      border-radius: 4px;
      letter-spacing: 0;
      text-transform: none;
      font-weight: 600;
    }
    .btn-primary:hover {
      background: var(--accent-strong);
      box-shadow: 0 6px 12px -4px rgba(0,102,255,.35);
      transform: translateY(-1px);
    }
    .btn-primary:active {
      transform: scale(1.02);
    }

    .btn-secondary, .btn-outline {
      border: 1px solid var(--line);
      background: #fff;
      color: var(--ink);
      box-shadow: none;
      border-radius: 4px;
      font-weight: 600;
      transition: all 250ms ease-in-out;
    }
    .btn-secondary:hover, .btn-outline:hover {
      border-color: var(--accent);
      color: var(--accent);
      box-shadow: var(--shadow);
    }
    .btn-secondary:active, .btn-outline:active {
      transform: scale(1.02);
    }

    .card, .telemetry-card, .hero-panel {
      border: 1px solid var(--line);
      background: #fff;
      box-shadow: var(--shadow);
      transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
    }
    .card:hover {
      border-color: rgba(0,102,255,.45);
      box-shadow: 0 20px 40px -16px rgba(15,23,42,.25);
      transform: translateY(-6px);
    }
    .card-frame {
      overflow: hidden;
      border-radius: 4px;
    }
    .card-frame img {
      transition: transform 400ms ease;
    }
    .card:hover .card-frame img,
    .card-frame:hover img {
      transform: scale(1.05);
    }

    .text-ink\/70 { color: rgba(10,25,47,.72) !important; }
    .text-ink\/60 { color: rgba(10,25,47,.62) !important; }
    .text-ink\/80 { color: rgba(10,25,47,.8) !important; }
    .text-ink\/50 { color: rgba(10,25,47,.5) !important; }

    .site-shell { position: relative; z-index: 1; }
    .site-shell > section { position: relative; z-index: 1; }

    .eyebrow {
      color: var(--accent);
      font-size: .72rem;
      font-weight: 700;
      letter-spacing: .13em;
      text-transform: uppercase;
    }

    .display-title, .section-title, .case-study-title, .cta-title, .page-title {
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--ink);
      letter-spacing: -.045em;
      line-height: 1.05;
    }
    .display-title { font-size: clamp(2.7rem, 6vw, 5.8rem); font-weight: 700; }
    .section-title { font-size: clamp(2rem, 4vw, 3.6rem); font-weight: 700; }
    .case-study-title { font-size: clamp(1.7rem, 3vw, 2.65rem); font-weight: 700; }
    .cta-title { font-size: clamp(2rem, 4vw, 3.6rem); font-weight: 700; }
    .page-title { font-size: clamp(2.2rem, 4vw, 3.2rem); font-weight: 700; }

    .accent-underline {
      text-decoration: underline;
      text-decoration-color: var(--accent);
      text-decoration-thickness: .1em;
      text-underline-offset: .1em;
    }

    .hero-section {
      background: linear-gradient(135deg, #F8FAFC 0%, #fff 72%);
      border-bottom: 1px solid var(--line);
    }
    .hero-copy, .section-lede { color: var(--muted); font-size: 1rem; line-height: 1.8; }

    .hero-dashboard {
      border: 1px solid var(--line);
      background: #fff;
      padding: 1.25rem;
      box-shadow: var(--shadow-lg);
    }
    .dashboard-header {
      display: flex; align-items: flex-start; justify-content: space-between;
      gap: 1rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--line);
    }
    .status-indicator { color: #166534; font-size: .7rem; font-weight: 700; white-space: nowrap; }
    .status-indicator span { display: inline-block; width: .45rem; height: .45rem; margin-right: .35rem; border-radius: 50%; background: #22C55E; }
    .dashboard-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: .75rem; padding-top: 1rem; }
    .metric-widget, .telemetry-widget {
      border: 1px solid var(--line); background: #fff; padding: 1.25rem; box-shadow: var(--shadow);
    }
    .metric-widget-wide { grid-column: span 2; }
    .metric-label, .metric-note { color: var(--slate); font-size: .7rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
    .metric-value { color: var(--ink); font-family: 'Plus Jakarta Sans', sans-serif; font-size: clamp(1.65rem, 3vw, 2.4rem); font-weight: 700; letter-spacing: -.04em; }
    .progress-track { height: .35rem; background: #E2E8F0; }
    .progress-fill { height: 100%; background: var(--accent); }
    .telemetry-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: .75rem; }

    .section-band { background: #F8FAFC; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .section-intro { margin-bottom: 3rem; }

    .bento-grid { display: grid; grid-template-columns: repeat(6, minmax(0,1fr)); gap: .75rem; }
    .solution-card, .process-step, .industry-card, .feature-card, .insight-card, .team-card {
      border: 1px solid var(--line); background: #fff; padding: 1.5rem; box-shadow: var(--shadow);
      transition: border-color .2s ease-in-out, box-shadow .2s ease-in-out, transform .2s ease-in-out;
    }
    .solution-card:hover, .process-step:hover, .industry-card:hover, .feature-card:hover, .insight-card:hover, .team-card:hover {
      border-color: rgba(0,102,255,.5); box-shadow: 0 20px 40px -16px rgba(15,23,42,.25); transform: translateY(-6px);
    }
    .solution-card { grid-column: span 2; }
    .solution-card-featured { grid-column: span 3; background: var(--ink); }
    .solution-card-featured h3, .solution-card-featured p, .solution-card-featured li { color: #fff; }
    .solution-card-wide { grid-column: span 3; }
    .solution-card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2.75rem; }
    .solution-index, .solution-mark { color: var(--accent); font-size: .8rem; font-weight: 700; }
    .solution-title { color: var(--ink); font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.4rem; font-weight: 700; }
    .solution-copy, .solution-list { color: var(--muted); font-size: .9rem; line-height: 1.7; }
    .solution-list { display: grid; gap: .45rem; margin-top: 1.25rem; font-size: .8rem; }

    .text-link {
      color: var(--accent); display: inline-flex; align-items: center; gap: .5rem;
      font-size: .82rem; font-weight: 700; transition: color .2s ease-in-out;
    }
    .text-link:hover { color: var(--accent-strong); }

    .process-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: .75rem; }
    .process-step span { color: var(--accent); font-size: .72rem; font-weight: 700; }
    .process-step h3 { color: var(--ink); font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.1rem; font-weight: 700; margin-top: 1.4rem; }
    .process-step p { color: var(--muted); font-size: .82rem; line-height: 1.65; margin-top: .45rem; }

    .industry-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: .75rem; }
    .industry-card { padding: 1.25rem; }
    .industry-card h3 { color: var(--ink); font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1rem; font-weight: 700; }
    .industry-card p { color: var(--accent); font-size: .72rem; font-weight: 600; margin-top: .6rem; }

    .presence-list { border-top: 1px solid var(--line); }
    .presence-list > div { display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--line); padding: 1rem 0; }
    .presence-list span { color: var(--ink); font-size: .9rem; font-weight: 600; }
    .presence-list small { color: var(--slate); font-size: .72rem; }

    .case-study-section { background: #F8FAFC; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .case-study-card { border: 1px solid var(--line); background: #fff; padding: 2rem; box-shadow: var(--shadow); }
    .case-metrics { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 1rem; border-top: 1px solid var(--line); padding-top: 1.25rem; }
    .case-metrics strong { color: var(--ink); display: block; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.8rem; }
    .case-metrics span { color: var(--slate); display: block; font-size: .7rem; margin-top: .35rem; }

    .cta-section { background: var(--dark); }
    .cta-section .eyebrow, .cta-section .text-link { color: #6699FF; }
    .cta-section .cta-title { color: #fff; }

    .bg-dark { background: var(--dark) !important; color: #FFFFFF !important; }
    .bg-dark h1, .bg-dark h2, .bg-dark h3, .bg-dark h4, .bg-dark h5, .bg-dark h6,
    .bg-dark .text-ink, .bg-dark .text-paper { color: #FFFFFF !important; }
    .bg-dark p, .bg-dark li, .bg-dark span { color: rgba(255,255,255,.78); }
    .bg-dark .text-paper\/60, .bg-dark .text-paper\/65, .bg-dark .text-paper\/70,
    .bg-dark .text-ink\/60, .bg-dark .text-ink\/70, .bg-dark .text-ink\/80 { color: rgba(255,255,255,.78) !important; }
    .bg-dark .border-paper\/15, .bg-dark .border-paper\/30, .bg-dark .border-paper\/40 { border-color: rgba(255,255,255,.25); }

    .prose-content p { color: var(--muted); line-height: 1.8; margin-bottom: 1.25rem; }
    .prose-content h2 { color: var(--ink); font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.75rem; font-weight: 700; margin-top: 2.5rem; margin-bottom: 1rem; }
    .prose-content h3 { color: var(--ink); font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.35rem; font-weight: 700; margin-top: 2rem; margin-bottom: .75rem; }
    .prose-content ul { margin-bottom: 1.25rem; }
    .prose-content li { color: var(--muted); line-height: 1.8; margin-bottom: .5rem; }
    .prose-content blockquote {
      border-left: 3px solid var(--accent); padding-left: 1.5rem; color: var(--slate);
      font-style: italic; margin: 1.5rem  0;
    }

    .breadcrumb { display: flex; align-items: center; gap: .5rem; font-size: .8rem; color: var(--slate); }
    .breadcrumb a { color: var(--accent); font-weight: 600; }
    .breadcrumb a:hover { color: var(--accent-strong); }

    .tag {
      display: inline-block; padding: .25rem .75rem; border: 1px solid var(--line);
      border-radius: 4px; font-size: .72rem; font-weight: 600; color: var(--slate);
      text-transform: uppercase; letter-spacing: .05em;
    }
    .tag-accent { border-color: rgba(0,102,255,.3); color: var(--accent); background: rgba(0,102,255,.05); }

    .stat-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.5rem; }
    .stat-box { border: 1px solid var(--line); background: #fff; padding: 2rem; text-align: center; box-shadow: var(--shadow); }
    .stat-box .stat-value { color: var(--ink); font-family: 'Plus Jakarta Sans', sans-serif; font-size: 2.5rem; font-weight: 700; }
    .stat-box .stat-label { color: var(--slate); font-size: .8rem; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; margin-top: .5rem; }

    .checklist { display: grid; gap: .75rem; }
    .checklist li { display: flex; align-items: flex-start; gap: .75rem; color: var(--muted); line-height: 1.7; }
    .checklist li::before { content: "✓"; color: var(--accent); font-weight: 700; flex-shrink: 0; }

    .tab-group { display: flex; gap: .5rem; border-bottom: 1px solid var(--line); margin-bottom: 2rem; }
    .tab-item { padding: .75rem 1.25rem; font-size: .85rem; font-weight: 600; color: var(--slate); border-bottom: 2px solid transparent; cursor: pointer; transition: all .15s ease; }
    .tab-item:hover { color: var(--accent); }
    .tab-item.active { color: var(--accent); border-bottom-color: var(--accent); }

    .grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 1.5rem; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 1.5rem; }
    .grid-4 { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 1rem; }

    .cta-band {
      background: var(--dark); color: #fff; padding: 4rem 0;
    }
    .cta-band h2 { color: #fff; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 2rem; font-weight: 700; }
    .cta-band p { color: rgba(255,255,255,.78); }



    .page-hero {
      background: linear-gradient(135deg, #F8FAFC 0%, #fff 72%);
      border-bottom: 1px solid var(--line);
      padding: 4rem 0 3rem;
    }
    .page-hero .eyebrow { margin-bottom: 1rem; }
    .page-hero p { color: var(--muted); font-size: 1.1rem; line-height: 1.7; max-width: 42rem; margin-top: 1.25rem; }

    .content-section { padding: 4rem 0; }
    .content-section-alt { background: #F8FAFC; padding: 4rem 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }

    .feature-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 1.5rem; }
    .feature-card { padding: 2rem; }
    .feature-card .feature-icon { width: 3rem; height: 3rem; display: flex; align-items: center; justify-content: center; background: rgba(0,102,255,.08); border-radius: 8px; margin-bottom: 1.25rem; }
    .feature-card .feature-icon svg { width: 1.5rem; height: 1.5rem; color: var(--accent); }
    .feature-card h3 { color: var(--ink); font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.15rem; font-weight: 700; margin-bottom: .75rem; }
    .feature-card p { color: var(--muted); font-size: .9rem; line-height: 1.7; }

    .team-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 1.5rem; }
    .team-card { text-align: center; padding: 2rem; }
    .team-card .team-avatar { width: 5rem; height: 5rem; border-radius: 50%; background: rgba(0,102,255,.1); margin: 0 auto 1rem; display: flex; align-items: center; justify-content: center; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.5rem; font-weight: 700; color: var(--accent); }
    .team-card h3 { color: var(--ink); font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.1rem; font-weight: 700; }
    .team-card p { color: var(--accent); font-size: .8rem; font-weight: 600; margin-top: .35rem; }

    .insight-card .insight-meta { color: var(--slate); font-size: .75rem; margin-bottom: .75rem; }
    .insight-card h3 { color: var(--ink); font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.15rem; font-weight: 700; margin-bottom: .5rem; }
    .insight-card p { color: var(--muted); font-size: .9rem; line-height: 1.6; }
    .insight-card .text-link { margin-top: 1rem; }

    .contact-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 2rem; }
    .contact-info { display: grid; gap: 1.5rem; }
    .contact-item { display: flex; align-items: flex-start; gap: 1rem; }
    .contact-item .contact-icon { width: 2.5rem; height: 2.5rem; display: flex; align-items: center; justify-content: center; background: rgba(0,102,255,.08); border-radius: 6px; flex-shrink: 0; }
    .contact-item .contact-icon svg { width: 1.25rem; height: 1.25rem; color: var(--accent); }
    .contact-item h4 { color: var(--ink); font-size: .9rem; font-weight: 700; margin-bottom: .25rem; }
    .contact-item p, .contact-item a { color: var(--muted); font-size: .85rem; }

    .form-group { margin-bottom: 1.25rem; }
    .form-label { display: block; font-size: .85rem; font-weight: 600; color: var(--ink); margin-bottom: .35rem; }
    .form-input, .form-select, .form-textarea {
      width: 100%; padding: .75rem 1rem; border: 1px solid var(--line); border-radius: 4px;
      font-size: .9rem; color: var(--ink); background: #fff; transition: border-color .15s ease;
    }
    .form-input:focus, .form-select:focus, .form-textarea:focus {
      outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(0,102,255,.1);
    }
    .form-textarea { min-height: 120px; resize: vertical; }

    @media (max-width: 767px) {
      .telemetry-grid, .industry-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
      .bento-grid, .process-grid, .grid-2, .grid-3, .grid-4, .feature-grid { grid-template-columns: 1fr; }
