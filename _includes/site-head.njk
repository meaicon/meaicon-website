<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="canonical" href="{{ canonical | default('https://www.meaicon.com/') }}">
  <link rel="stylesheet" href="/assets/css/cookie-consent.css">
  <script src="/assets/js/cookie-consent.js" defer></script>
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta property="og:title" content="{{ ogTitle | default(title) }}">
  <meta property="og:description" content="{{ ogDescription | default(description) }}">
  <meta property="og:type" content="website">
  <meta property="og:image" content="https://www.meaicon.com/assets/brand/meaicon/meaicon-LLC-FZ-logo-black.png">
  <meta property="og:url" content="{{ canonical | default('https://www.meaicon.com/') }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ twitterTitle | default(ogTitle | default(title)) }}">
  <meta name="twitter:description" content="{{ twitterDescription | default(ogDescription | default(description)) }}">
  <meta name="twitter:image" content="https://www.meaicon.com/assets/brand/meaicon/meaicon-LLC-FZ-logo-black.png">
  {% if legacySource %}
  {{ legacySource | legacyJsonLd | safe }}
  {% else %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "MEAICON LLC FZ",
    "url": "https://www.meaicon.com/",
    "address": { "@type": "PostalAddress", "addressCountry": "AE", "addressLocality": "Dubai", "streetAddress": "Meydan Free Zone" },
    "contactPoint": { "@type": "ContactPoint", "telephone": "+971 55 513 5784", "contactType": "sales" },
    "sameAs": [
      "https://www.linkedin.com/company/meaicon/",
      "https://x.com/meaicon",
      "https://www.instagram.com/meaicon.official/",
      "https://www.facebook.com/Meaicon.Official",
      "https://www.youtube.com/channel/UCVbuZOFqHeFGAMmzu3jE3oA"
    ]
  }
  </script>
  {% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          paper: '#FAFBFC',
          card: '#FFFFFF',
          ink: '#0A192F',
          muted: '#475569',
          accent: '#4F46E5',
          teal: '#1E40AF',
          line: '#E2E8F0',
          dark: '#0A192F',
          slate: '#64748B'
        },
        fontFamily: {
          display:['"Space Grotesk"','sans-serif'],
          sans:['Inter','sans-serif'],
          mono:['"JetBrains Mono"','monospace']
        }
      }
    }
  }
  </script>
  <style>
    :root {
      --paper: #070B12;
      --card: #0E1726;
      --ink: #F3F4F6;
      --muted: #9CA3AF;
      --accent: #00F0FF;
      --accent-strong: #00D8F5;
      --teal: #00E5A3;
      --teal-strong: #0ECF97;
      --line: #1E293B;
      --dark: #070A12;
      --surface: rgba(15, 23, 34, 0.82);
      --surface-strong: rgba(17, 24, 39, 0.96);
      --body: #D8E0EA;
      --glow: rgba(0, 240, 255, 0.25);
      --grid: rgba(148, 163, 184, 0.08);
    }

    html { background: var(--paper); }
    body {
      font-family: 'Inter', sans-serif;
      color: var(--ink);
      background:
        linear-gradient(180deg, rgba(7,11,18,0.98) 0%, rgba(9,15,24,1) 100%),
        radial-gradient(circle at top left, rgba(0, 240, 255, 0.12), transparent 30%),
        radial-gradient(circle at top right, rgba(0, 229, 163, 0.08), transparent 25%);
      background-attachment: fixed;
      position: relative;
    }
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(var(--grid) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid) 1px, transparent 1px);
      background-size: 44px 44px;
      mask-image: radial-gradient(circle at center, black 30%, transparent 100%);
      pointer-events: none;
      opacity: 0.5;
    }

    .font-display { font-family: 'Space Grotesk', sans-serif; }
    .font-mono { font-family: 'JetBrains Mono', monospace; }
    body, p, li, span, div { color: var(--body); }
    h1, h2, h3, h4, h5, h6, strong, b { color: var(--ink); }
    ::selection { background: rgba(0, 240, 255, 0.25); color: var(--ink); }

    a { transition: color .15s ease, border-color .15s ease, background-color .15s ease, transform .15s ease, box-shadow .15s ease; }
    .nav-link {
      position: relative;
      color: rgba(243, 244, 246, 0.8);
    }
    .nav-link::after {
      content: '';
      position: absolute;
      left: 0; right: 0; bottom: -8px;
      height: 1px;
      background: linear-gradient(90deg, var(--accent), var(--teal));
      box-shadow: 0 0 16px rgba(0, 240, 255, 0.5);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform .2s ease;
    }
    .nav-link:hover::after { transform: scaleX(1); }
    .nav-link:hover { color: var(--ink); }

    .hairline { border-color: rgba(148, 163, 184, 0.18); }
    .node-pulse { animation: nodePulse 2.8s ease-in-out infinite; }
    @keyframes nodePulse { 0%,100% { opacity:1; transform:scale(1); } 50% { opacity:.45; transform:scale(1.18); } }
    .line-draw { stroke-dasharray:500; stroke-dashoffset:500; animation:drawLine 1.4s ease forwards; }
    @keyframes drawLine { to { stroke-dashoffset:0; } }
    @media (prefers-reduced-motion: reduce) { .node-pulse,.line-draw { animation:none; stroke-dashoffset:0; } }

    .btn-primary {
      border: 1px solid rgba(0, 240, 255, 0.7);
      background: linear-gradient(135deg, rgba(0, 240, 255, 0.18), rgba(0, 229, 163, 0.18));
      color: var(--ink);
      box-shadow: 0 0 0 1px rgba(0, 240, 255, 0.2), 0 0 24px rgba(0, 240, 255, 0.12);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 600;
    }
    .btn-primary:hover {
      background: linear-gradient(135deg, rgba(0, 240, 255, 0.28), rgba(0, 229, 163, 0.22));
      box-shadow: 0 0 0 1px rgba(0, 240, 255, 0.3), 0 0 32px rgba(0, 240, 255, 0.2);
      transform: translateY(-1px);
    }

    .btn-outline {
      border: 1px solid rgba(148,163,184,0.35);
      background: rgba(15, 23, 34, 0.45);
      color: var(--ink);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 600;
    }
    .btn-outline:hover {
      border-color: rgba(0, 240, 255, 0.7);
      box-shadow: 0 0 0 1px rgba(0, 240, 255, 0.22), 0 0 20px rgba(0, 240, 255, 0.1);
      color: var(--accent);
    }

    .card {
      border: 1px solid rgba(30,41,59,0.9);
      background: linear-gradient(180deg, rgba(11,20,31,0.84), rgba(9,15,23,0.9));
      box-shadow: 0 0 0 1px rgba(148,163,184,0.05), 0 16px 32px rgba(2, 6, 23, 0.35);
      transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
    }
    .card:hover {
      border-color: rgba(0, 240, 255, 0.45);
      box-shadow: 0 0 0 1px rgba(0, 240, 255, 0.18), 0 20px 40px rgba(2, 6, 23, 0.4), 0 0 20px rgba(0, 240, 255, 0.08);
      transform: translateY(-2px);
    }

    .telemetry-card {
      border: 1px solid rgba(30,41,59,0.9);
      background: linear-gradient(180deg, rgba(12,18,28,0.9), rgba(8,12,18,0.9));
      box-shadow: inset 0 0 0 1px rgba(148,163,184,0.04);
    }
    .hero-panel {
      border: 1px solid rgba(30,41,59,0.9);
      background: linear-gradient(180deg, rgba(15, 23, 34, 0.75), rgba(10,15,22,0.9));
      box-shadow: 0 0 0 1px rgba(0, 240, 255, 0.05), 0 20px 40px rgba(2, 6, 23, 0.48);
    }

    .section-kicker {
      color: var(--accent);
      letter-spacing: 0.22em;
      text-transform: uppercase;
      font-size: 11px;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 600;
    }
    .section-title {
      font-family: 'Space Grotesk', sans-serif;
      letter-spacing: -0.04em;
      line-height: 1.02;
    }

    .text-ink\/70, .text-ink\/60, .text-ink\/80, .text-ink\/50 { opacity: 1; }
    .text-ink\/70 { color: rgba(243,244,246,0.72) !important; }
    .text-ink\/60 { color: rgba(243,244,246,0.62) !important; }
    .text-ink\/80 { color: rgba(243,244,246,0.8) !important; }
    .text-ink\/50 { color: rgba(243,244,246,0.5) !important; }

    .site-shell {
      position: relative;
      z-index: 1;
    }
    .site-shell > section {
      position: relative;
      z-index: 1;
    }
    .glow-cyan { box-shadow: 0 0 24px rgba(0, 240, 255, 0.12); }
    /* Elite Enterprise Trust landing-page system */
    :root { --paper:#FAFBFC; --card:#FFFFFF; --ink:#0A192F; --muted:#475569; --accent:#4F46E5; --accent-strong:#4338CA; --line:#E2E8F0; --shadow:0 4px 6px -1px rgba(0,0,0,0.05); }
    html, body { background:var(--paper); color:var(--ink); }
    body { background:var(--paper); }
    .font-display { font-family:'Plus Jakarta Sans', sans-serif; }
    .font-mono { font-family:'Inter', sans-serif; }
    body, p, li, span, div { color:var(--muted); }
    h1, h2, h3, h4, h5, h6, strong, b { color:var(--ink); }
    .nav-link { color:rgba(10,25,47,.78); }
    .nav-link::after { background:var(--accent); box-shadow:none; }
    .nav-link:hover { color:var(--accent); }
    .btn-primary { border:1px solid var(--accent); background:var(--accent); color:#fff; box-shadow:var(--shadow); border-radius:4px; letter-spacing:0; text-transform:none; }
    .btn-primary:hover { background:var(--accent-strong); box-shadow:0 6px 12px -4px rgba(79,70,229,.35); }
    .btn-outline, .btn-secondary { border:1px solid var(--line); background:#fff; color:var(--ink); box-shadow:none; border-radius:4px; }
    .btn-outline:hover, .btn-secondary:hover { border-color:var(--accent); color:var(--accent); box-shadow:var(--shadow); }
    .card, .telemetry-card, .hero-panel { border:1px solid var(--line); background:#fff; box-shadow:var(--shadow); }
    .card:hover { border-color:rgba(79,70,229,.45); box-shadow:0 8px 16px -8px rgba(15,23,42,.18); }
    .text-ink\/70 { color:rgba(10,25,47,.72)!important; }
    .text-ink\/60 { color:rgba(10,25,47,.62)!important; }
    .text-ink\/80 { color:rgba(10,25,47,.8)!important; }
    .text-ink\/50 { color:rgba(10,25,47,.5)!important; }
    .site-shell { position:relative; z-index:1; }
    .eyebrow { color:var(--accent); font-size:.72rem; font-weight:700; letter-spacing:.13em; text-transform:uppercase; }
    .display-title, .section-title, .case-study-title, .cta-title { font-family:'Plus Jakarta Sans',sans-serif; color:var(--ink); letter-spacing:-.045em; line-height:1.05; }
    .display-title { font-size:clamp(2.7rem,6vw,5.8rem); font-weight:700; }
    .section-title { font-size:clamp(2rem,4vw,3.6rem); font-weight:700; }
    .case-study-title { font-size:clamp(1.7rem,3vw,2.65rem); font-weight:700; }
    .cta-title { font-size:clamp(2rem,4vw,3.6rem); font-weight:700; }
    .accent-underline { text-decoration:underline; text-decoration-color:var(--accent); text-decoration-thickness:.1em; text-underline-offset:.1em; }
    .hero-section { background:linear-gradient(135deg,#F8FAFC 0%,#fff 72%); border-bottom:1px solid var(--line); }
    .hero-copy, .section-lede { color:var(--muted); font-size:1rem; line-height:1.8; }
    .hero-dashboard { border:1px solid var(--line); background:#fff; padding:1.25rem; box-shadow:0 10px 24px -14px rgba(15,23,42,.25); }
    .dashboard-header { display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; padding-bottom:1.25rem; border-bottom:1px solid var(--line); }
    .status-indicator { color:#166534; font-size:.7rem; font-weight:700; white-space:nowrap; }
    .status-indicator span { display:inline-block; width:.45rem; height:.45rem; margin-right:.35rem; border-radius:50%; background:#22C55E; }
    .dashboard-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.75rem; padding-top:1rem; }
    .metric-widget, .telemetry-widget { border:1px solid var(--line); background:#fff; padding:1.25rem; box-shadow:var(--shadow); }
    .metric-widget-wide { grid-column:span 2; }
    .metric-label, .metric-note { color:#64748B; font-size:.7rem; font-weight:600; letter-spacing:.08em; text-transform:uppercase; }
    .metric-value { color:var(--ink); font-family:'Plus Jakarta Sans',sans-serif; font-size:clamp(1.65rem,3vw,2.4rem); font-weight:700; letter-spacing:-.04em; }
    .progress-track { height:.35rem; background:#E2E8F0; }
    .progress-fill { height:100%; background:var(--accent); }
    .telemetry-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.75rem; }
    .section-band { background:#F8FAFC; border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
    .bento-grid { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:.75rem; }
    .solution-card, .process-step, .industry-card { border:1px solid var(--line); background:#fff; padding:1.5rem; box-shadow:var(--shadow); transition:border-color .2s ease-in-out,box-shadow .2s ease-in-out,transform .2s ease-in-out; }
    .solution-card:hover, .process-step:hover, .industry-card:hover { border-color:rgba(79,70,229,.5); box-shadow:0 8px 16px -8px rgba(15,23,42,.18); transform:translateY(-2px); }
    .solution-card { grid-column:span 2; }
    .solution-card-featured { grid-column:span 3; background:var(--ink); }
    .solution-card-featured h3, .solution-card-featured p, .solution-card-featured li { color:#fff; }
    .solution-card-wide { grid-column:span 3; }
    .solution-card-top { display:flex; align-items:center; justify-content:space-between; margin-bottom:2.75rem; }
    .solution-index, .solution-mark { color:var(--accent); font-size:.8rem; font-weight:700; }
    .solution-title { color:var(--ink); font-family:'Plus Jakarta Sans',sans-serif; font-size:1.4rem; font-weight:700; }
    .solution-copy, .solution-list { color:var(--muted); font-size:.9rem; line-height:1.7; }
    .solution-list { display:grid; gap:.45rem; margin-top:1.25rem; font-size:.8rem; }
    .text-link { color:var(--accent); display:inline-flex; align-items:center; gap:.5rem; font-size:.82rem; font-weight:700; transition:color .2s ease-in-out; }
    .text-link:hover { color:var(--accent-strong); }
    .process-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.75rem; }
    .process-step span { color:var(--accent); font-size:.72rem; font-weight:700; }
    .process-step h3 { color:var(--ink); font-family:'Plus Jakarta Sans',sans-serif; font-size:1.1rem; font-weight:700; margin-top:1.4rem; }
    .process-step p { color:var(--muted); font-size:.82rem; line-height:1.65; margin-top:.45rem; }
    .industry-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.75rem; }
    .industry-card { padding:1.25rem; }
    .industry-card h3 { color:var(--ink); font-family:'Plus Jakarta Sans',sans-serif; font-size:1rem; font-weight:700; }
    .industry-card p { color:var(--accent); font-size:.72rem; font-weight:600; margin-top:.6rem; }
    .presence-list { border-top:1px solid var(--line); }
    .presence-list > div { display:flex; align-items:center; justify-content:space-between; gap:1rem; border-bottom:1px solid var(--line); padding:1rem 0; }
    .presence-list span { color:var(--ink); font-size:.9rem; font-weight:600; }
    .presence-list small { color:#64748B; font-size:.72rem; }
    .case-study-section { background:#F8FAFC; border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
    .case-study-card { border:1px solid var(--line); background:#fff; padding:2rem; box-shadow:var(--shadow); }
    .case-metrics { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; border-top:1px solid var(--line); padding-top:1.25rem; }
    .case-metrics strong { color:var(--ink); display:block; font-family:'Plus Jakarta Sans',sans-serif; font-size:1.8rem; }
    .case-metrics span { color:#64748B; display:block; font-size:.7rem; margin-top:.35rem; }
    .cta-section { background:var(--ink); }
    .cta-section .eyebrow, .cta-section .text-link { color:#A5B4FC; }
    .cta-section .cta-title { color:#fff; }
    /* Legacy content uses bg-dark for CTA and process bands. Keep those sections readable. */
    .bg-dark { background:#0A192F!important; color:#FFFFFF!important; }
    .bg-dark h1, .bg-dark h2, .bg-dark h3, .bg-dark h4, .bg-dark h5, .bg-dark h6,
    .bg-dark .text-ink, .bg-dark .text-paper { color:#FFFFFF!important; }
    .bg-dark p, .bg-dark li, .bg-dark span { color:rgba(255,255,255,.78); }
    .bg-dark .text-paper\/60, .bg-dark .text-paper\/65, .bg-dark .text-paper\/70,
    .bg-dark .text-ink\/60, .bg-dark .text-ink\/70, .bg-dark .text-ink\/80 { color:rgba(255,255,255,.78)!important; }
    .bg-dark .border-paper\/15, .bg-dark .border-paper\/30, .bg-dark .border-paper\/40 { border-color:rgba(255,255,255,.25); }
    @media (max-width:767px) { .telemetry-grid,.industry-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .bento-grid,.process-grid { grid-template-columns:1fr; } .solution-card,.solution-card-featured,.solution-card-wide { grid-column:auto; } .case-metrics { grid-template-columns:1fr; } .presence-list small { text-align:right; } }
  </style>
</head>
