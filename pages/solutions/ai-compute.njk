<script>
(function() {
  const cfgForm = document.getElementById('configurator-form');
  const priceUSD = document.getElementById('price-usd');
  const priceAED = document.getElementById('price-aed');

  const USD_RATE = 1.08;
  const AED_RATE = 3.97;
  const MARKUP = 1.25;

  function updatePrice() {
    const gpuChecked = cfgForm.querySelector('input[name="gpu"]:checked');
    const cpuSelect = cfgForm.querySelector('#cpu-select');
    const ramSelect = cfgForm.querySelector('#ram-select');
    const deliveryChecked = cfgForm.querySelector('input[name="delivery"]:checked');

    let base = 0;
    if (gpuChecked) base += parseFloat(gpuChecked.dataset.basePrice);
    if (cpuSelect && cpuSelect.selectedOptions.length > 0) base += parseFloat(cpuSelect.selectedOptions[0].dataset.basePrice);
    if (ramSelect && ramSelect.selectedOptions.length > 0) base += parseFloat(ramSelect.selectedOptions[0].dataset.basePrice);

    let multiplier = 1.0;
    if (deliveryChecked) multiplier = parseFloat(deliveryChecked.dataset.multiplier);

    const total = base * MARKUP * multiplier;
    const totalUSD = total * USD_RATE;
    const totalAED = total * AED_RATE;

    priceUSD.textContent = '$' + Math.round(totalUSD).toLocaleString();
    priceAED.textContent = Math.round(totalAED).toLocaleString() + ' AED';
  }

  cfgForm.addEventListener('change', updatePrice);
  updatePrice();
})();
</script>
