  <script>
    const cfgForm = document.getElementById('configurator-form');
    const warning = document.getElementById('constraint-warning');

    cfgForm.addEventListener('change', () => {
      const gpu = cfgForm.querySelector('input[name="gpu"]:checked')?.value;
      const ram = cfgForm.querySelector('input[name="ram"]:checked')?.value;

      // Constraint: 8x GPUs requires >= 2304GB RAM
      if (gpu?.includes('8x') && ram && parseInt(ram) < 2304) {
        warning.textContent = "Selecting 8x GPUs requires a minimum of 2304GB RAM.";
        warning.classList.remove('hidden');
      } else {
        warning.classList.add('hidden');
      }
    });
