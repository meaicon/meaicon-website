<script>
  // State Management
  const state = {
    selectedOptions: {},
    basePrice: 0,
    currentTotal: 0
  };

  const form = document.getElementById('configurator-form');
  const priceUSD = document.getElementById('price-usd');
  const priceAED = document.getElementById('price-aed');

  const USD_RATE = 1.08;
  const AED_RATE = 3.97;
  const MARKUP = 1.25;

  // JSON Data Source
  const productData = {
    "gpu": [
      {"id": "rtx3090", "label": "MI-RTX3090", "price": 4999},
      {"id": "a100-40", "label": "MI-A100-40GB", "price": 8999},
      {"id": "h100", "label": "MI-H100", "price": 14999}
    ],
    "cpu": [
      {"id": "epyc-9654", "label": "AMD EPYC 9654", "price": 1200},
      {"id": "xeon-gold", "label": "Intel Xeon Gold 6448Y", "price": 800}
    ],
    "ram": [
      {"id": "512gb", "label": "512GB DDR5", "price": 800},
      {"id": "1tb", "label": "1TB DDR5", "price": 1400},
      {"id": "2tb", "label": "2TB DDR5", "price": 2400}
    ]
  };

  // Hardware Constraints
  const constraints = {
    "h100": { "minRam": 2304, "message": "8x GPUs requires a minimum of 2304GB RAM." }
  };

  function updateState() {
    const gpuChecked = form.querySelector('input[name="gpu"]:checked');
    const cpuSelect = form.querySelector('#cpu-select');
    const ramSelect = form.querySelector('#ram-select');
    const deliveryChecked = form.querySelector('input[name="delivery"]:checked');

    state.selectedOptions = {
      gpu: gpuChecked?.value || null,
      cpu: cpuSelect?.value || null,
      ram: ramSelect?.value || null,
      delivery: deliveryChecked?.value || null
    };

    state.basePrice = 0;
    if (state.selectedOptions.gpu) {
      const gpu = productData.gpu.find(g => g.id === state.selectedOptions.gpu);
      if (gpu) state.basePrice += gpu.price;
    }
    if (state.selectedOptions.cpu) {
      const cpu = productData.cpu.find(c => c.id === state.selectedOptions.cpu);
      if (cpu) state.basePrice += cpu.price;
    }
    if (state.selectedOptions.ram) {
      const ram = productData.ram.find(r => r.id === state.selectedOptions.ram);
      if (ram) state.basePrice += ram.price;
    }

    let multiplier = deliveryChecked ? parseFloat(deliveryChecked.dataset.multiplier) : 1.0;
    
    state.currentTotal = state.basePrice * MARKUP * multiplier;
    
    // Update display
    const totalUSD = state.currentTotal * USD_RATE;
    const totalAED = state.currentTotal * AED_RATE;
    
    priceUSD.textContent = '$' + Math.round(totalUSD).toLocaleString();
    priceAED.textContent = Math.round(totalAED).toLocaleString() + ' AED';

    // Check constraints
    const warning = document.getElementById('constraint-warning');
    if (state.selectedOptions.gpu?.includes('h100') && state.selectedOptions.ram?.includes('512')) {
      warning.textContent = constraints.h100.message;
      warning.classList.remove('hidden');
    } else {
      warning.classList.add('hidden');
    }
  }

  form.addEventListener('change', updateState);
  updateState();
</script>

