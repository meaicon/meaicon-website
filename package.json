{
  "name": "meaicon-website",
  "version": "1.0.0",
  "private": true,
  "description": "Static Meaicon marketing website built with Eleventy.",
  "scripts": {
    "build": "eleventy && npm run build:css",
    "build:css": "tailwindcss -i ./assets/css/tailwind-input.css -o ./_site/assets/css/tailwind.css --minify",
    "start": "eleventy --serve & npm run watch:css",
    "watch:css": "tailwindcss -i ./assets/css/tailwind-input.css -o ./_site/assets/css/tailwind.css --watch",
    "clean": "rimraf _site",
    "audit:metadata": "node scripts/audit-metadata.js",
    "validate:content": "node scripts/validate-content.js",
    "generate:page": "node scripts/generate-page.js",
    "generate:pages": "node scripts/generate-pages-from-manifest.js",
    "lint": "eslint assets/js/ .eleventy.js 2>/dev/null || echo 'eslint not configured — skipping'",
    "format": "prettier --write assets/css/ assets/js/ .eleventy.js _headers robots.txt 2>/dev/null || echo 'prettier not configured — skipping'",
    "audit": "npm audit --omit=dev"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.13.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "@11ty/eleventy-img": "^7.0.0"
  }
}
